# /opt/n8n/control-plane/backend.env  (chmod 0600, never in Git)
#
# Every secret here is generated FRESH on the VPS. Nothing is copied from Railway.
# Generate 32-byte hex values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or, on the VPS without node:
#   openssl rand -hex 32

# Image tag pulled by backend.compose.yml (latest, or a sha-<commit> tag for rollback)
BACKEND_TAG=latest

# Meta / Facebook App
META_APP_ID=
META_APP_SECRET=                 # RESET in Meta App Dashboard → Settings → Basic before pasting
META_CONFIG_ID=
# META_SOLUTION_ID=
# META_SYSTEM_USER_TOKEN=        # regenerate in Business Settings → System Users if you use it
META_API_VERSION=v25.0

# Webhooks — must match the value set in Meta App Dashboard → Webhooks
META_WEBHOOK_VERIFY_TOKEN=

# Security
ENCRYPTION_KEY=                  # NEW 64-hex key. Existing rows are re-encrypted by scripts/rotate-encryption-key.mjs
ADMIN_API_KEY=                   # NEW key. Update every caller of /api/admin/*

# Server
CORS_ORIGINS=https://botargento.com.ar,https://www.botargento.com.ar
LOG_LEVEL=info
